              "script": {
                "exec": [
                  "pm.test('Token exchange returns access token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('oauth_access_token', json.access_token);",
                  "  if (json.refresh_token) pm.collectionVariables.set('oauth_refresh_token', json.refresh_token);",
