            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('oauth_code')) {",
                  "  throw new Error('Run OAuth (authorize) first to obtain oauth_code.');",
                  "}",
                  "if (!pm.collectionVariables.get('oauth_code_verifier')) {",
                  "  throw new Error('Missing oauth_code_verifier. Re-run OAuth (authorize).');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
