        {
          "name": "OAuth (authorize)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const verifier = (pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}')).replace(/-/g, '');",
                  "const hash = CryptoJS.SHA256(verifier);",
                  "const challenge = CryptoJS.enc.Base64.stringify(hash).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const state = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('oauth_code_verifier', verifier);",
                  "pm.collectionVariables.set('oauth_code_challenge', challenge);",
                  "pm.collectionVariables.set('oauth_state', state);",
                  "console.log('PKCE generated for OAuth authorize request');"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Authorize returned an authorization code', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('oauth_code', json.code);",
                  "  if (json.state) pm.collectionVariables.set('oauth_state', json.state);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
