NODE_ENV=production
PORT=3001

# --- Primary database connection (LOCALHOST) ---
# Recommended for dissertation artifact: PostgreSQL running on the host machine
DATABASE_URL="postgresql://postgres:password@localhost:5432/dissertation_auth_db"

# --- Redis (LOCALHOST) ---
REDIS_URL="redis://localhost:6379"

SESSION_SECRET="replace-with-a-long-random-secret"
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"


# ---------------------------------------------------------------------------
# OPTIONAL: Docker-based configuration
# Use these ONLY if running PostgreSQL and Redis inside Docker Compose.
# The hostnames below (auth-postgres, auth-redis) exist ONLY inside Docker's
# internal network and will NOT work on Windows outside of Docker.
# ---------------------------------------------------------------------------

# DATABASE_URL="postgresql://postgres:password@auth-postgres:5432/dissertation_auth_db"
# REDIS_URL="redis://auth-redis:6379"
