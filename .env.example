NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app_user:*******@localhost:5432/dissertation_auth_db

SESSION_SECRET=replace-with-long-random-secret
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_MAX_AGE_MS=86400000
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
REDIS_URL=redis://localhost:6379

TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_AUDIENCE=api-auth-eval
JWT_ISSUER=api-auth-service
JWT_ALGORITHM=RS256
JWT_EXPIRES_IN=1h
JWT_ACTIVE_KID=default
JWT_PRIVATE_KEY_PATH=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEYS_JSON=
JWT_SECRET=

OAUTH_REQUIRE_PKCE=true
OAUTH_ALLOWED_REDIRECTS=https://example.com/callback
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=300

AUTH_RATE_LIMIT_MAX=200
LOG_LEVEL=info
HEALTHCHECK_TOKEN=
MFA_ISSUER=API Auth Evaluation