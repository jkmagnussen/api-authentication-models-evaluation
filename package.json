{
  "name": "dissertation-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:oauth:redirect-misconfigured": "ts-node misconfigurations/oauth/redirect-misconfiguration/run-tests.ts",
    "test:oauth:state-misconfigured": "ts-node misconfigurations/oauth/state-misconfiguration/run-tests.ts",
    "test:oauth:scope-misconfigured": "ts-node misconfigurations/oauth/scope-misconfiguration/run-tests.ts",
    "test:variant:oauth:redirect": "ts-node scripts/run-variant-focused-tests.ts oauth-redirect-misconfiguration",
    "test:variant:oauth:state": "ts-node scripts/run-variant-focused-tests.ts oauth-state-misconfiguration",
    "test:variant:oauth:scope": "ts-node scripts/run-variant-focused-tests.ts oauth-scope-misconfiguration",
    "test:jwt:audience-misconfigured": "ts-node misconfigurations/jwt/audience-misconfiguration/run-tests.ts",
    "test:jwt:algorithm-misconfigured": "ts-node misconfigurations/jwt/algorithm-misconfiguration/run-tests.ts",
    "test:jwt:expiry-misconfigured": "ts-node misconfigurations/jwt/expiry-misconfiguration/run-tests.ts",
    "test:variant:jwt:audience": "ts-node scripts/run-variant-focused-tests.ts jwt-audience-misconfiguration",
    "test:variant:jwt:algorithm": "ts-node scripts/run-variant-focused-tests.ts jwt-algorithm-misconfiguration",
    "test:variant:jwt:expiry": "ts-node scripts/run-variant-focused-tests.ts jwt-expiry-misconfiguration",
    "test:sessions:fixation-misconfigured": "ts-node misconfigurations/sessions/fixation-misconfiguration/run-tests.ts",
    "test:sessions:cookie-misconfigured": "ts-node misconfigurations/sessions/cookie-flag-misconfiguration/run-tests.ts",
    "test:sessions:logout-misconfigured": "ts-node misconfigurations/sessions/logout-misconfiguration/run-tests.ts",
    "test:variant:sessions:fixation": "ts-node scripts/run-variant-focused-tests.ts sessions-fixation-misconfiguration",
    "test:variant:sessions:cookie": "ts-node scripts/run-variant-focused-tests.ts sessions-cookie-flag-misconfiguration",
    "test:variant:sessions:logout": "ts-node scripts/run-variant-focused-tests.ts sessions-logout-misconfiguration",
    "test:variants:focused": "ts-node scripts/run-all-variant-focused-tests.ts",
    "variants:report": "ts-node scripts/generate-variant-differential-report.ts",
    "ai:generate:oauth": "ts-node ai-generated/oauth/generate.ts",
    "ai:generate:jwt": "ts-node ai-generated/jwt/generate.ts",
    "ai:generate:sessions": "ts-node ai-generated/sessions/generate.ts",
    "ai:analyse": "ts-node ai-generated/analyse-samples.ts",
    "ai:validate-controls": "ts-node ai-generated/validate-controls.ts",
    "ai:report": "ts-node scripts/generate-ai-evaluation-report.ts",
    "compare:reports": "ts-node scripts/generate-comparative-insights-report.ts",
    "code:footprint": "ts-node scripts/generate-code-footprint-report.ts",
    "docs:pdf": "npx md-to-pdf docs/REPO_QUICK_GUIDE.md",
    "docs:check": "ts-node scripts/check-generated-docs.ts",
    "docs:drift": "ts-node scripts/check-generated-drift.ts",
    "docs:drift:strict": "ts-node scripts/check-generated-drift.ts --strict-untracked",
    "docs:lint": "markdownlint-cli2",
    "docs:generate:variants": "npm run test:variants:focused && npm run variants:report",
    "docs:generate:code": "npm run code:footprint",
    "docs:generate:performance": "npm run perf:analyze",
    "docs:generate:ai": "npm run compare:reports && npm run ai:report",
    "docs:generate:package": "npm run docs:pdf && npm run docs:check",
    "docs:generate": "npm run docs:generate:variants && npm run docs:generate:code && npm run docs:generate:performance && npm run docs:generate:ai && npm run docs:generate:package",
    "docs:verify": "npm run docs:drift && npm run docs:lint",
    "docs:verify:strict": "npm run docs:drift:strict && npm run docs:lint",
    "ci:docs": "npm run docs:generate && npm run docs:verify",
    "ci:docs:strict": "npm run docs:generate && npm run docs:verify:strict",
    "ci:tests": "npm test",
    "ci:local": "npm run ci:docs && npm run ci:tests",
    "ci:local:strict": "npm run ci:docs:strict && npm run ci:tests",
    "mutation:test": "npx stryker run mutation.stryker.json",
    "perf:repeat": "ts-node scripts/run-repeated-performance.ts 5",
    "py:install": "python -m pip install -r analysis-python/requirements.txt",
    "py:charts": "python analysis-python/generate_charts.py",
    "ai:test:oauth": "ts-node ai-generated/oauth/run-sample-tests.ts",
    "ai:test:jwt": "ts-node ai-generated/jwt/run-sample-tests.ts",
    "ai:test:sessions": "ts-node ai-generated/sessions/run-sample-tests.ts",
    "perf:once": "npm test -- tests/performance && ts-node scripts/generate-performance-csv.ts",
    "perf:analyze": "ts-node scripts/analyze-performance.ts",
    "perf": "npm run perf:once && npm run perf:analyze"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "md-to-pdf": "^5.2.4",
    "markdownlint-cli2": "^0.18.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^16.0.0",
    "escomplex": "^2.0.0-alpha",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "oauth-pkce": "^0.0.7",
    "pkce-challenge": "^6.0.0",
    "prisma": "^6.0.0"
  }
}
