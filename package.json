{
  "name": "dissertation-backend",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "scripts": {
    "prepare:env": "node scripts/prepare-db-env.js",
    "predev": "npm run prepare:env",
    "prestart": "npm run prepare:env",
    "preprod": "npm run prepare:env",
    "predb:setup": "npm run prepare:env",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "build:compile": "npm run build",
    "start": "node dist/src/server.js",
    "prod": "npm run build && npm start",
    "prod:full": "npm run clean:artifacts && npm run db:generate && npm run db:migrate && npm run db:seed && npm run build && npm start",
    "docker:build": "docker build -t dissertation-backend:local .",
    "test": "jest --runInBand",
    "docs:check": "ts-node scripts/check-generated-docs.ts",
    "clean:artifacts": "node scripts/clean-generated-artifacts.js"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^30.4.2",
    "jstat": "^1.9.6",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.2.2",
    "dotenv": "^16.0.0",
    "escomplex": "^2.0.0-alpha",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pkce-challenge": "^6.0.0",
    "prisma": "^6.0.0",
    "redis": "^6.1.0"
  }
}
